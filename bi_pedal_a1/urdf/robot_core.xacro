<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <xacro:property name="scale_factor" value="0.001 0.001 0.001"/>
    <xacro:property name="package_name" value="bi_pedal_a1"/>

    <!-- ****************************************************************************************** -->
    <!-- ***************************************** Base ******************************************* -->
    <!-- ****************************************************************************************** -->

    <link name="world"/>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/base_link.stl" scale="${scale_factor}"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/base_link.stl" scale="${scale_factor}"/>
            </geometry>
        </collision>
        <!-- <inertial>
            <origin xyz="0 -0.00225 0.01017"/>
            <mass value="2.234" />
            <inertia ixx="0.001" ixy="0.00000022295" ixz="0.0000001396"
                    iyx="0.00000022295" iyy="0.05" iyz="0.000004933"
                    izx="0.0000001396" izy="0.000004933" izz="0.05" />
        </inertial> -->
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.6324" rpy="0 0 0"/>
    </joint>

    <!-- ****************************************************************************************** -->
    <!-- ***************************************** Left Hip *************************************** -->
    <!-- ****************************************************************************************** -->

    <link name="left_hip">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/left_hip.stl" scale="${scale_factor}"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/left_hip.stl" scale="${scale_factor}"/>
            </geometry>
        </collision>
        <!-- <inertial>
            <origin xyz="0.00262 0 0.04794"/>
            <mass value="0.3847" />
            <inertia ixx="0.0004" ixy="-0.0000013" ixz="-0.000002522"
                    iyx="-0.0000013" iyy="0.0002" iyz="0.000000485"
                    izx="-0.000002522" izy="0.000000485" izz="0.0002" />
        </inertial> -->
    </link>

    <joint name="left_hip_joint" type="revolute">
        <parent link="base_link"/>
        <child link="left_hip"/>
        <origin xyz="-0.148 -0.0175 0.01" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="${-pi/2}" upper="${pi/2}" effort="10" velocity="1"/>
    </joint>

    <!-- ****************************************************************************************** -->
    <!-- ***************************************** Right Hip *************************************** -->
    <!-- ****************************************************************************************** -->

    <link name="right_hip">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/right_hip.stl" scale="${scale_factor}"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/right_hip.stl" scale="${scale_factor}"/>
            </geometry>
        </collision>
        <!-- <inertial>
            <origin xyz="-0.00262 0 0.04794"/>
            <mass value="0.3847" />
            <inertia ixx="0.0004" ixy="-0.0000013" ixz="0.000003369"
                    iyx="-0.0000013" iyy="0.0002" iyz="0.000000485"
                    izx="0.000003369" izy="-0.000000485" izz="0.0002" />
        </inertial> -->
    </link>

    <joint name="right_hip_joint" type="revolute">
        <parent link="base_link"/>
        <child link="right_hip"/>
        <origin xyz="0.148 -0.0175 0.01" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="${pi/2}" upper="${-pi/2}" effort="10" velocity="1"/>
    </joint>

    <!-- ****************************************************************************************** -->
    <!-- ***************************************** Left thigh ************************************* -->
    <!-- ****************************************************************************************** -->

    <link name="left_thigh">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/left_thigh.stl" scale="${scale_factor}"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/left_thigh.stl" scale="${scale_factor}"/>
            </geometry>
        </collision>
        <!-- <inertial>
            <origin xyz="0.0148 0 -0.201"/>
            <mass value="0.619" />
            <inertia ixx="0.009" ixy="0.000001214" ixz="0.000031265"
                    iyx="0.000001214" iyy="0.009" iyz="0.000009833"
                    izx="0.000031265" izy="0.000009833" izz="0.0002" />
        </inertial> -->
    </link>

    <joint name="left_thigh_joint" type="revolute">
        <parent link="left_hip"/>
        <child link="left_thigh"/>
        <origin xyz="0.0175 0 0.051" rpy="${-pi/2} 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="${-pi/2}" upper="${pi/2}" effort="10" velocity="1"/>
    </joint>

    <!-- ****************************************************************************************** -->
    <!-- ***************************************** right thigh ************************************ -->
    <!-- ****************************************************************************************** -->

    <link name="right_thigh">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/right_thigh.stl" scale="${scale_factor}"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/right_thigh.stl" scale="${scale_factor}"/>
            </geometry>
        </collision>
        <!-- <inertial>
            <origin xyz="-0.0139 0 -0.201"/>
            <mass value="0.619" />
            <inertia ixx="0.009" ixy="0.000001214" ixz="0.000031265"
                    iyx="0.000001214" iyy="0.009" iyz="0.000009833"
                    izx="0.000031265" izy="0.000009833" izz="0.0002" />
        </inertial> -->
    </link>

    <joint name="right_thigh_joint" type="revolute">
        <parent link="right_hip"/>
        <child link="right_thigh"/>
        <origin xyz="-0.0175 0 0.051" rpy="${-pi/2} 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="${-pi/2}" upper="${pi/2}" effort="10" velocity="1"/>
    </joint>

    <!-- ****************************************************************************************** -->
    <!-- ***************************************** Left shin ************************************* -->
    <!-- ****************************************************************************************** -->

    <link name="left_shin">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/left_shin.stl" scale="${scale_factor}"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/left_shin.stl" scale="${scale_factor}"/>
            </geometry>
        </collision>
        <!-- <inertial>
            <origin xyz="-0.0136 0 -0.2296"/>
            <mass value="0.542" />
            <inertia ixx="0.006" ixy="0.000001214" ixz="0.000031265"
                    iyx="0.000001214" iyy="0.005" iyz="0.000009833"
                    izx="0.000031265" izy="0.000009833" izz="0.002" />
        </inertial> -->
    </link>

    <joint name="left_shin_joint" type="revolute">
        <parent link="left_thigh"/>
        <child link="left_shin"/>
        <origin xyz="0 0 -0.2885" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="${-pi/2}" upper="${pi/2}" effort="10" velocity="1"/>
    </joint>

    <!-- ****************************************************************************************** -->
    <!-- ***************************************** right shin ************************************* -->
    <!-- ****************************************************************************************** -->

    <link name="right_shin">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/right_shin.stl" scale="${scale_factor}"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/right_shin.stl" scale="${scale_factor}"/>
            </geometry>
        </collision>
        <!-- <inertial>
            <origin xyz="0.01466 0 -0.2296"/>
            <mass value="0.542" />
            <inertia ixx="0.006" ixy="0.000001214" ixz="-0.000007509"
                    iyx="0.000001257" iyy="0.005" iyz="-0.000009833"
                    izx="-0.000007509" izy="-0.000009833" izz="0.002" />
        </inertial> -->
    </link>

    <joint name="right_shin_joint" type="revolute">
        <parent link="right_thigh"/>
        <child link="right_shin"/>
        <origin xyz="0 0 -0.2885" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="${-pi/2}" upper="${pi/2}" effort="10" velocity="1"/>
    </joint>

    <!-- ****************************************************************************************** -->
    <!-- ***************************************** Left foot ************************************* -->
    <!-- ****************************************************************************************** -->

    <link name="left_foot">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/left_foot.stl" scale="${scale_factor}"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/left_foot.stl" scale="${scale_factor}"/>
            </geometry>
        </collision>
        <!-- <inertial>
            <origin xyz="0.0049 0 -0.0351"/>
            <mass value="0.233" />
            <inertia ixx="0.002" ixy="0.000000214" ixz="-0.000045314"
                    iyx="0.000000214" iyy="0.0002" iyz="0.000000194"
                    izx="-0.000045314" izy="0.000000194" izz="0.0001" />
        </inertial> -->
    </link>

    <joint name="left_foot_joint" type="revolute">
        <parent link="left_shin"/>
        <child link="left_foot"/>
        <origin xyz="0 0 -0.2885" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="${-pi/2}" upper="${pi/2}" effort="10" velocity="1"/>
    </joint>

        <!-- ****************************************************************************************** -->
    <!-- ***************************************** Right foot ************************************* -->
    <!-- ****************************************************************************************** -->

    <link name="right_foot">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/right_foot.stl" scale="${scale_factor}"/>
            </geometry>
            <material name="grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://${package_name}/meshes/right_foot.stl" scale="${scale_factor}"/>
            </geometry>
        </collision>
        <!-- <inertial>
            <origin xyz="-0.00477 0 -0.0351"/>
            <mass value="0.233" />
            <inertia ixx="0.002" ixy="-0.000000068" ixz="0.000045314"
                    iyx="-0.000000068" iyy="0.0002" iyz="-0.000000137"
                    izx="0.000045314" izy="-0.000000137" izz="0.0001" />
        </inertial> -->
    </link>

    <joint name="right_foot_joint" type="revolute">
        <parent link="right_shin"/>
